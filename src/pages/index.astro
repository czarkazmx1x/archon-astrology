<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Archon Astrology | Premium Mystic Intelligence</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@300;400;500&display=swap" rel="stylesheet">
    <script>
        const storedTheme = localStorage.getItem('archon-theme');
        if (storedTheme === 'light') document.documentElement.setAttribute('data-theme', 'light');
    </script>
    <style>
        :root {
            --bg: #050506;
            --surface: rgba(10, 10, 12, 0.7);
            --surface-hover: rgba(14, 14, 18, 0.95);
            --fg: #fafafa;
            --muted: #8a8a93;
            --border: rgba(200, 169, 126, 0.12);
            --border-hover: rgba(200, 169, 126, 0.35);
            --accent: #c8a97e;
            --accent-glow: rgba(200, 169, 126, 0.08);
            --accent-bright: #e6c89c;
            --spring: cubic-bezier(0.16, 1, 0.3, 1); /* Ultra premium custom spring */
            --linear: cubic-bezier(0.4, 0, 0.2, 1);
            --glass: blur(24px) saturate(190%);
        }

        html[data-theme="light"] {
            --bg: #f8f5f0;
            --surface: rgba(245, 240, 230, 0.7);
            --surface-hover: rgba(235, 225, 210, 0.95);
            --fg: #1a1816;
            --muted: #6e655c;
            --border: rgba(140, 110, 70, 0.15);
            --border-hover: rgba(140, 110, 70, 0.4);
            --accent: #a38258;
            --accent-glow: rgba(140, 110, 70, 0.08);
            --accent-bright: #8a6639;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            background-color: var(--bg);
        }

        body {
            background-color: var(--bg);
            color: var(--fg);
            font-family: 'Inter', system-ui, sans-serif;
            line-height: 1.6;
            min-height: 100vh;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            position: relative;
        }

        /* Ambient Glowing Celestial Background Mesh */
        .ambient-glow-1 {
            position: absolute;
            top: -10%;
            left: -10%;
            width: 70%;
            height: 70%;
            background: radial-gradient(circle, rgba(200, 169, 126, 0.06) 0%, rgba(200, 169, 126, 0.015) 45%, transparent 70%);
            pointer-events: none;
            z-index: 1;
        }

        .ambient-glow-2 {
            position: absolute;
            bottom: -5%;
            right: -10%;
            width: 60%;
            height: 70%;
            background: radial-gradient(circle, rgba(200, 169, 126, 0.05) 0%, rgba(200, 169, 126, 0.01) 35%, transparent 60%);
            pointer-events: none;
            z-index: 1;
        }

        /* Noise texture overlay */
        .noise-overlay {
            content: "";
            position: fixed;
            inset: 0;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
            opacity: 0.015;
            pointer-events: none;
            z-index: 9999;
        }

        /* Custom Custom Cursor */
        .custom-cursor {
            width: 6px;
            height: 6px;
            background: var(--accent-bright);
            border-radius: 50%;
            position: fixed;
            pointer-events: none;
            z-index: 10000;
            transform: translate(-50%, -50%);
            transition: width 0.2s, height 0.2s, background-color 0.2s;
            box-shadow: 0 0 10px var(--accent-bright);
        }

        .custom-cursor-ring {
            width: 32px;
            height: 32px;
            border: 1px solid rgba(200, 169, 126, 0.25);
            border-radius: 50%;
            position: fixed;
            pointer-events: none;
            z-index: 9999;
            transform: translate(-50%, -50%);
            transition: transform 0.05s ease-out, width 0.2s, height 0.2s, border-color 0.2s;
        }

        /* Fading gold sparkle trails */
        .sparkle {
            position: fixed;
            width: 3px;
            height: 3px;
            background: var(--accent);
            border-radius: 50%;
            pointer-events: none;
            z-index: 9998;
            opacity: 1;
            transform: translate(-50%, -50%);
            box-shadow: 0 0 6px var(--accent);
            transition: opacity 0.6s var(--linear), transform 0.6s var(--linear);
        }

        /* Layout */
        .container {
            max-width: 1300px;
            margin: 0 auto;
            padding: 0 3rem;
            position: relative;
            z-index: 10;
        }

        header {
            padding: 2rem 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(200, 169, 126, 0.08);
            background: transparent;
        }

        .logo {
            font-family: 'Playfair Display', serif;
            font-size: 1.15rem;
            font-weight: 500;
            letter-spacing: 0.15em;
            color: var(--fg);
            text-decoration: none;
            text-transform: uppercase;
            position: relative;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .logo::before {
            content: '✦';
            color: var(--accent);
            font-size: 0.8rem;
            transition: transform var(--spring) 0.8s;
        }

        .logo:hover::before {
            transform: rotate(180deg);
        }

        .logo span {
            color: var(--accent);
            font-style: italic;
            font-weight: 400;
            letter-spacing: 0.05em;
            margin-left: 0.25rem;
        }

        nav {
            display: flex;
            gap: 2.5rem;
            position: relative;
        }

        nav a {
            color: var(--muted);
            text-decoration: none;
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.15em;
            transition: color var(--linear) 0.3s;
            position: relative;
            padding: 0.5rem 0;
        }

        nav a::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0%;
            height: 1px;
            background: var(--accent);
            transition: width 0.3s var(--spring);
        }

        nav a:hover {
            color: var(--fg);
        }

        nav a:hover::after {
            width: 100%;
        }

        .theme-toggle-btn {
            background: none;
            border: 1px solid var(--border);
            color: var(--muted);
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s var(--spring);
            margin-left: 0.5rem;
        }

        .theme-toggle-btn:hover {
            color: var(--accent-bright);
            border-color: var(--accent-bright);
            transform: scale(1.1);
        }

        /* Showstopping Hero Vortex Section background canvas */
        #hero-vortex-canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100vw;
            height: 950px;
            pointer-events: none;
            z-index: 2;
        }

        .hero {
            padding: 9rem 0;
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            align-items: start;
            gap: 5rem;
            position: relative;
            z-index: 10;
        }

        .hero-content {
            max-width: 600px;
            position: relative;
            z-index: 5;
            padding-top: 2.5rem;
        }

        .category-tag {
            text-transform: uppercase;
            letter-spacing: 0.35em;
            margin-bottom: 1.5rem;
            font-size: 0.7rem;
            color: var(--accent);
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .category-tag::after {
            content: '';
            width: 30px;
            height: 1px;
            background: var(--accent);
            opacity: 0.5;
        }

        h1 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(3.2rem, 5.5vw, 4.8rem);
            font-weight: 400;
            line-height: 1.05;
            margin-bottom: 2rem;
            letter-spacing: -0.02em;
        }

        h1 span {
            color: var(--accent);
            font-style: italic;
        }

        .hero p.description {
            color: var(--muted);
            font-size: 1.05rem;
            line-height: 1.7;
            max-width: 480px;
        }

        /* Impeccable Custom Glassmorphic Card */
        .premium-card {
            background: var(--surface);
            backdrop-filter: var(--glass);
            -webkit-backdrop-filter: var(--glass);
            border: 1px solid var(--border);
            position: relative;
            padding: 3.5rem 3rem;
            transition: all var(--spring) 0.6s;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5);
            border-radius: 1px;
            z-index: 5;
        }

        /* Super fine glowing double-border border gradient */
        .premium-card::before {
            content: "";
            position: absolute;
            inset: 0;
            border: 1px solid transparent;
            background: linear-gradient(135deg, rgba(200, 169, 126, 0.3), transparent 30%, transparent 70%, rgba(200, 169, 126, 0.15)) border-box;
            -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: destination-out;
            mask-composite: exclude;
            pointer-events: none;
        }

        .premium-card:hover {
            transform: translateY(-4px);
            border-color: var(--border-hover);
            box-shadow: 0 35px 70px rgba(0, 0, 0, 0.7), 0 0 25px rgba(200, 169, 126, 0.05);
            background: var(--surface-hover);
        }

        .decoder-header {
            margin-bottom: 2.5rem;
            border-bottom: 1px solid rgba(200, 169, 126, 0.06);
            padding-bottom: 1.5rem;
        }

        .decoder-status {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.6rem;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.3em;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .status-dot {
            width: 5px;
            height: 5px;
            background-color: var(--accent);
            border-radius: 50%;
            display: inline-block;
            box-shadow: 0 0 8px var(--accent);
            animation: pulse-dot 2s infinite var(--linear);
        }

        @keyframes pulse-dot {
            0%, 100% { opacity: 0.4; }
            50% { opacity: 1; }
        }

        /* Impeccable Custom Form Dropdown elements */
        .form-group {
            margin-bottom: 2rem;
            position: relative;
        }

        label {
            display: block;
            font-size: 0.65rem;
            font-weight: 600;
            color: var(--muted);
            margin-bottom: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.25em;
        }

        
        .quiz-option-btn {
            background: var(--surface);
            border: 1px solid var(--border);
            color: var(--fg);
            padding: 1.1rem 1.4rem;
            border-radius: 4px;
            text-align: left;
            font-family: 'Inter', sans-serif;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all var(--spring) 0.3s;
            line-height: 1.5;
            position: relative;
            overflow: hidden;
        }

        .quiz-option-btn:hover {
            border-color: var(--accent);
            background: var(--surface-hover);
            transform: translateX(4px);
        }
        
        .quiz-option-btn::before {
            content: '';
            position: absolute;
            top: 0; left: 0; width: 3px; height: 100%;
            background: var(--accent);
            transform: scaleY(0);
            transition: transform 0.3s var(--spring);
            transform-origin: bottom;
        }
        
        .quiz-option-btn:hover::before {
            transform: scaleY(1);
        }
\n        /* Interactive Select Container */
        .luxury-select-container {
            position: relative;
            background: var(--surface);
            border: 1px solid var(--border);
            transition: all var(--spring) 0.3s;
            cursor: pointer;
            user-select: none;
        }

        .luxury-select-container:hover {
            border-color: var(--border-hover);
            background: var(--surface-hover);
        }

        .luxury-select-container.active {
            border-color: var(--accent);
            box-shadow: 0 0 15px rgba(200, 169, 126, 0.05);
            z-index: 100;
        }

        .luxury-select-trigger {
            padding: 1.1rem 1.4rem;
            font-size: 0.8rem;
            font-weight: 500;
            letter-spacing: 0.05em;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: var(--fg);
        }

        .luxury-select-trigger::after {
            content: '▾';
            color: var(--accent);
            font-size: 0.7rem;
            transition: transform var(--spring) 0.4s;
        }

        .luxury-select-container.active .luxury-select-trigger::after {
            transform: rotate(180deg);
        }

        .luxury-dropdown-menu {
            position: absolute;
            top: calc(100% + 5px);
            left: 0;
            width: 100%;
            background: var(--bg);
            border: 1px solid var(--accent);
            z-index: 50;
            opacity: 0;
            visibility: hidden;
            transform: translateY(10px);
            transition: all var(--spring) 0.4s;
            box-shadow: 0 15px 40px rgba(0,0,0,0.8);
        }

        .luxury-select-container.active .luxury-dropdown-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .luxury-dropdown-item {
            padding: 1rem 1.4rem;
            font-size: 0.8rem;
            color: var(--muted);
            transition: all var(--linear) 0.2s;
            border-left: 1px solid transparent;
        }

        .luxury-dropdown-item:hover {
            color: var(--accent-bright);
            background: rgba(200, 169, 126, 0.04);
            border-left-color: var(--accent);
        }

        .luxury-dropdown-item.selected {
            color: var(--accent);
            font-weight: 600;
            background: rgba(200, 169, 126, 0.02);
            border-left-color: var(--accent);
        }

        /* Tactile snap button CTA */
        .cta-button {
            width: 100%;
            background: transparent;
            border: 1px solid var(--accent);
            color: var(--accent);
            padding: 1.3rem;
            font-family: 'Inter', sans-serif;
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.3em;
            cursor: pointer;
            transition: all var(--spring) 0.4s;
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .cta-button::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 120%;
            height: 0;
            background: var(--accent);
            transform: translate(-50%, -50%) rotate(45deg);
            z-index: 1;
            transition: height 0.4s var(--spring);
        }

        .cta-button span {
            position: relative;
            z-index: 2;
            transition: color var(--spring) 0.4s;
        }

        .cta-button:hover {
            box-shadow: 0 0 35px rgba(200, 169, 126, 0.15);
            border-color: var(--accent-bright);
        }

        .cta-button:hover::before {
            height: 450%;
        }

        .cta-button:hover span {
            color: var(--bg);
        }

        /* Coordinate Board Section */
        .board-section {
            padding: 10rem 0;
            border-top: 1px solid rgba(200, 169, 126, 0.08);
            position: relative;
        }

        .board-header {
            margin-bottom: 5rem;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }

        .board-header h2 {
            font-family: 'Playfair Display', serif;
            font-size: 2.8rem;
            font-weight: 400;
            letter-spacing: -0.01em;
        }

        .board-telemetry {
            text-align: right;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.7rem;
            color: var(--accent);
            letter-spacing: 0.1em;
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        /* Precision Telemetry Board Grid with Astrolabe */
        .coordinate-grid-wrapper {
            position: relative;
            border: 1px solid rgba(200, 169, 126, 0.08);
            padding: 0.5px;
        }

        .coordinate-grid {
            height: 620px;
            background-color: rgba(9, 9, 11, 0.4);
            position: relative;
            overflow: hidden;
        }

        /* Rotating Background Astrolabe Vectors */
        .astrolabe-bg {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(0deg);
            width: 700px;
            height: 700px;
            pointer-events: none;
            opacity: 0.18;
            z-index: 2;
            transition: transform 0.5s ease-out;
        }

        .astrolabe-ring {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            border: 0.5px dashed rgba(200, 169, 126, 0.25);
            border-radius: 50%;
            pointer-events: none;
        }

        .astrolabe-ring-1 { width: 250px; height: 250px; }
        .astrolabe-ring-2 { width: 450px; height: 450px; border-style: double; border-width: 1px; }
        .astrolabe-ring-3 { width: 620px; height: 620px; border-style: solid; border-color: rgba(200, 169, 126, 0.1); }

        .coordinate-grid-lines {
            position: absolute;
            inset: 0;
            background-image: 
                linear-gradient(rgba(200, 169, 126, 0.035) 1px, transparent 1px),
                linear-gradient(90deg, rgba(200, 169, 126, 0.035) 1px, transparent 1px);
            background-size: 40px 40px;
            background-position: center center;
            z-index: 1;
        }

        /* Precise Hover Telemetry Tracking Reticle */
        .grid-reticle-h, .grid-reticle-v {
            position: absolute;
            background: rgba(200, 169, 126, 0.12);
            pointer-events: none;
            z-index: 3;
            transition: opacity 0.3s;
            opacity: 0;
        }
        .grid-reticle-h { height: 0.5px; width: 100%; left: 0; }
        .grid-reticle-v { width: 0.5px; height: 100%; top: 0; }

        .reticle-tracker {
            position: absolute;
            padding: 4px 8px;
            background: rgba(8, 8, 10, 0.95);
            border: 0.5px solid var(--accent);
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.6rem;
            color: var(--accent-bright);
            pointer-events: none;
            z-index: 5;
            opacity: 0;
            transition: opacity 0.3s;
            white-space: nowrap;
            letter-spacing: 0.05em;
        }

        /* Planet Markers Refined */
        .planet-marker {
            position: absolute;
            display: flex;
            align-items: center;
            gap: 1.25rem;
            z-index: 15;
            transition: transform var(--spring) 0.5s;
        }

        .marker-visual {
            position: relative;
            display: grid;
            place-items: center;
            width: 32px;
            height: 32px;
        }

        /* Thin orbital rings revolving around planet markers */
        .marker-orbit-ring {
            position: absolute;
            width: 38px;
            height: 38px;
            border: 0.5px solid rgba(200, 169, 126, 0.15);
            border-radius: 50%;
            animation: spin-orbit 12s linear infinite;
        }

        .marker-orbit-ring::after {
            content: '';
            position: absolute;
            top: -2px;
            left: 50%;
            width: 4px;
            height: 4px;
            background: var(--accent);
            border-radius: 50%;
        }

        @keyframes spin-orbit {
            100% { transform: rotate(360deg); }
        }

        .marker-svg {
            width: 20px;
            height: 20px;
            fill: none;
            stroke: var(--accent);
            stroke-width: 1.2;
            filter: drop-shadow(0 0 6px rgba(200, 169, 126, 0.4));
            transition: all var(--spring) 0.6s;
            position: relative;
            z-index: 2;
        }

        .planet-marker:hover {
            transform: scale(1.05);
        }

        .planet-marker:hover .marker-svg {
            stroke: var(--accent-bright);
            filter: drop-shadow(0 0 12px rgba(200, 169, 126, 0.8));
            transform: scale(1.15) rotate(15deg);
        }

        .planet-marker:hover .marker-orbit-ring {
            border-color: rgba(200, 169, 126, 0.45);
            animation-duration: 4s;
        }

        .marker-label-group {
            display: flex;
            flex-direction: column;
            gap: 0.2rem;
            background: rgba(7, 7, 8, 0.7);
            padding: 0.4rem 0.8rem;
            backdrop-filter: blur(5px);
            border: 0.5px solid rgba(200, 169, 126, 0.05);
        }

        .marker-name {
            font-family: 'Playfair Display', serif;
            font-size: 1.1rem;
            color: var(--fg);
            letter-spacing: 0.02em;
            font-weight: 500;
        }

        .marker-data {
            font-size: 0.58rem;
            font-family: 'JetBrains Mono', monospace;
            color: var(--muted);
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        /* Dynamic Cosmic Particle Canvas overlay */
        #particles-canvas {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 2;
        }

        /* Typographic Quote Footer Section */
        footer {
            padding: 8rem 0;
            text-align: center;
            border-top: 1px solid rgba(200, 169, 126, 0.08);
            position: relative;
        }

        .quote-container {
            position: relative;
            max-width: 600px;
            margin: 0 auto 2.5rem auto;
        }

        .quote-container::before {
            content: "“";
            font-family: 'Playfair Display', serif;
            font-size: 6rem;
            color: rgba(200, 169, 126, 0.05);
            position: absolute;
            top: -3.5rem;
            left: 50%;
            transform: translateX(-50%);
            pointer-events: none;
        }

        .quote {
            font-family: 'Playfair Display', serif;
            font-style: italic;
            font-size: 1.35rem;
            color: var(--accent);
            letter-spacing: 0.08em;
            line-height: 1.7;
            text-transform: uppercase;
        }

        .footer-brand {
            margin-top: 2rem;
            font-size: 0.6rem;
            color: var(--muted);
            letter-spacing: 0.45em;
            text-transform: uppercase;
            font-weight: 500;
        }

        /* Broadcasts Section Styling */
        .broadcasts-section {
            padding: 10rem 0;
            border-top: 1px solid rgba(200, 169, 126, 0.08);
            position: relative;
        }

        .broadcasts-header {
            margin-bottom: 5rem;
        }

        .broadcasts-header h2 {
            font-family: 'Playfair Display', serif;
            font-size: 2.8rem;
            font-weight: 400;
            letter-spacing: -0.01em;
        }

        .broadcast-display {
            display: grid;
            grid-template-columns: 1.3fr 0.7fr;
            gap: 3.5rem;
            align-items: stretch;
        }

        .active-video-container {
            position: relative;
            background: #030304;
            border: 1px solid var(--border);
            aspect-ratio: 16/9;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all var(--spring) 0.5s;
        }

        .active-video-container::before {
            content: "";
            position: absolute;
            inset: 0;
            border: 1px solid transparent;
            background: linear-gradient(135deg, rgba(200, 169, 126, 0.25), transparent 40%, transparent 60%, rgba(200, 169, 126, 0.12)) border-box;
            -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: destination-out;
            mask-composite: exclude;
            pointer-events: none;
            z-index: 10;
        }

        .active-video-container iframe {
            width: 100%;
            height: 100%;
            border: none;
            position: relative;
            z-index: 2;
            transition: opacity 0.4s ease;
            opacity: 1;
        }

        .video-overlay-scanline {
            position: absolute;
            inset: 0;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
            background-size: 100% 4px, 6px 100%;
            pointer-events: none;
            z-index: 5;
            opacity: 0.15;
        }

        .video-playlist {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            max-height: 480px;
            overflow-y: auto;
            padding-right: 0.5rem;
        }

        /* Customize Scrollbar for video playlist */
        .video-playlist::-webkit-scrollbar {
            width: 3px;
        }
        .video-playlist::-webkit-scrollbar-track {
            background: transparent;
        }
        .video-playlist::-webkit-scrollbar-thumb {
            background: rgba(200, 169, 126, 0.15);
        }
        .video-playlist::-webkit-scrollbar-thumb:hover {
            background: var(--accent);
        }

        .playlist-item {
            display: flex;
            gap: 1.25rem;
            background: rgba(14, 14, 16, 0.4);
            border: 1px solid rgba(200, 169, 126, 0.05);
            padding: 1rem;
            cursor: pointer;
            transition: all var(--spring) 0.4s;
            align-items: center;
        }

        .playlist-item:hover {
            background: rgba(18, 18, 22, 0.8);
            border-color: rgba(200, 169, 126, 0.25);
            transform: translateX(4px);
        }

        .playlist-item.active {
            background: rgba(200, 169, 126, 0.05);
            border-color: var(--accent);
        }

        .playlist-thumbnail {
            width: 100px;
            height: 60px;
            background-size: cover;
            background-position: center;
            position: relative;
            border: 1px solid rgba(200, 169, 126, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .playlist-thumbnail::before {
            content: '';
            position: absolute;
            inset: 0;
            background: rgba(5, 5, 6, 0.45);
            transition: background 0.3s;
        }

        .playlist-item:hover .playlist-thumbnail::before {
            background: rgba(5, 5, 6, 0.15);
        }

        .playlist-play-icon {
            font-size: 0.8rem;
            color: var(--accent);
            position: relative;
            z-index: 5;
            text-shadow: 0 0 10px var(--accent);
            transform: scale(1);
            transition: transform var(--spring) 0.4s;
        }

        .playlist-item:hover .playlist-play-icon {
            transform: scale(1.3) rotate(90deg);
            color: var(--accent-bright);
        }

        .playlist-meta {
            display: flex;
            flex-direction: column;
            gap: 0.2rem;
        }

        .playlist-title {
            font-family: 'Playfair Display', serif;
            font-size: 1rem;
            color: var(--fg);
            transition: color 0.3s;
        }

        .playlist-item:hover .playlist-title {
            color: var(--accent);
        }

        .playlist-duration {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.58rem;
            color: var(--muted);
            letter-spacing: 0.08em;
        }

        @media (max-width: 1024px) {
            .container { padding: 0 2rem; }
            .hero { grid-template-columns: 1fr; text-align: center; gap: 4rem; }
            .hero-content { margin: 0 auto; }
            .hero p.description { margin: 0 auto; }
            .broadcast-display {
                grid-template-columns: 1fr;
                gap: 2.5rem;
            }
        }

        /* Telemetry Drawer Overlay */
        .telemetry-drawer {
            position: absolute;
            top: 0;
            right: 0;
            width: 330px;
            height: 100%;
            background: rgba(6, 6, 8, 0.96);
            backdrop-filter: blur(28px) saturate(180%);
            -webkit-backdrop-filter: blur(28px) saturate(180%);
            border-left: 1px solid var(--border);
            z-index: 100;
            transform: translateX(100%);
            transition: transform var(--spring) 0.6s;
            padding: 3.5rem 2.2rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: -15px 0 50px rgba(0, 0, 0, 0.7);
        }

        .telemetry-drawer::before {
            content: "";
            position: absolute;
            inset: 0;
            border-left: 1px solid transparent;
            background: linear-gradient(180deg, rgba(200, 169, 126, 0.35), transparent 40%) border-box;
            -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: destination-out;
            mask-composite: exclude;
            pointer-events: none;
        }

        .telemetry-drawer.active {
            transform: translateX(0);
        }

        .drawer-close {
            position: absolute;
            top: 1.5rem;
            right: 1.5rem;
            background: transparent;
            border: none;
            color: var(--accent);
            font-size: 0.9rem;
            cursor: pointer;
            transition: transform var(--spring) 0.4s, color var(--linear) 0.2s;
        }

        .drawer-close:hover {
            transform: rotate(90deg) scale(1.2);
            color: var(--accent-bright);
        }

        .drawer-content {
            display: flex;
            flex-direction: column;
            gap: 1.8rem;
            height: 100%;
        }

        .drawer-planet-title {
            font-family: 'Playfair Display', serif;
            font-size: 2.2rem;
            color: var(--accent-bright);
            font-weight: 400;
            letter-spacing: -0.01em;
            margin-top: 1rem;
        }

        .drawer-planet-subtitle {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.62rem;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.25em;
            margin-top: -1.2rem;
        }

        .drawer-stat-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.25rem;
            border-top: 1px solid rgba(200, 169, 126, 0.08);
            border-bottom: 1px solid rgba(200, 169, 126, 0.08);
            padding: 1.5rem 0;
        }

        .drawer-stat-label {
            font-size: 0.58rem;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.15em;
            margin-bottom: 0.35rem;
        }

        .drawer-stat-value {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.78rem;
            color: var(--accent);
            font-weight: 500;
        }

        .drawer-description {
            font-size: 0.82rem;
            line-height: 1.65;
            color: #d1d1d6;
        }

        .drawer-quote {
            font-family: 'Playfair Display', serif;
            font-style: italic;
            font-size: 1rem;
            color: var(--accent);
            border-left: 2px solid var(--accent);
            padding-left: 1.2rem;
            margin-top: auto;
            line-height: 1.5;
        }

        /* Custom Focal Coordinate Dropper Marker */
        .focal-marker {
            position: absolute;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 24px;
            height: 24px;
            z-index: 18;
            transform: translate(-50%, -50%);
            animation: pulse-focal 2s infinite ease-in-out;
            pointer-events: none;
        }

        @keyframes pulse-focal {
            0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.85; }
            50% { transform: translate(-50%, -50%) scale(1.25); opacity: 1; }
        }

        .focal-marker::before {
            content: '✦';
            color: var(--accent-bright);
            font-size: 1.25rem;
            text-shadow: 0 0 12px var(--accent-bright);
        }

        .focal-ripple {
            position: absolute;
            width: 100%;
            height: 100%;
            border: 0.5px solid var(--accent-bright);
            border-radius: 50%;
            animation: ripple-out 1.6s infinite linear;
        }

        @keyframes ripple-out {
            0% { transform: scale(0.6); opacity: 1; }
            100% { transform: scale(2.5); opacity: 0; }
        }
    </style>
    <script src="/quiz-data.js" is:inline></script>
</head>
