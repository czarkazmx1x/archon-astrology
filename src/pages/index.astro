        // Interactive 3D Cosmic Star Vortex Canvas Background (Eye-stopping wow factor)
        const vortexCanvas = document.getElementById('hero-vortex-canvas');
        const vCtx = vortexCanvas.getContext('2d');
        
        let vWidth = vortexCanvas.width = window.innerWidth;
        let vHeight = vortexCanvas.height = 950;
        
        window.addEventListener('resize', () => {
            vWidth = vortexCanvas.width = window.innerWidth;
        });

        const stars = [];
        const starCount = 380;
        let vortexSpeed = 0.0008;
        let warpActive = false;
        let warpFactor = 1.0;
        let targetWarpFactor = 1.0;
        let centralPull = 1.0;
        
        // Mouse reaction coordinates
        let mouseX = vWidth * 0.7;
        let mouseY = vHeight * 0.5;

        // Trace mouse coordinate tracking inside hero canvas
        document.addEventListener('mousemove', (e) => {
            mouseX += (e.clientX - mouseX) * 0.05;
            mouseY += (e.clientY - mouseY) * 0.05;
        });

        for (let i = 0; i < starCount; i++) {
            // Distribute stars in concentric elliptical orbits around a center
            const angle = Math.random() * Math.PI * 2;
            const radius = Math.random() * 380 + 80;
            stars.push({
                angle: angle,
                radius: radius,
                originalRadius: radius,
                speed: (Math.random() * 0.002 + 0.0005) * (400 / radius), // Farther stars move slower
                size: Math.random() * 1.1 + 0.3,
                brightness: Math.random() * 0.5 + 0.5,
                colorChance: Math.random()
            });
        }

        function drawVortex() {
            vCtx.fillStyle = 'rgba(5, 5, 6, 0.25)'; // Smooth trails fading
            vCtx.fillRect(0, 0, vWidth, vHeight);

            // Dynamically interpolate speed/warp factors
            warpFactor += (targetWarpFactor - warpFactor) * 0.05;
            const currentSpeed = vortexSpeed * warpFactor;

            // Central gravity center is right next to the card
            const centerX = vWidth * 0.68;
            const centerY = vHeight * 0.48;

            stars.forEach(s => {
                s.angle += s.speed * warpFactor;
                
                // Mouse gravity warp: warp orbits slightly toward custom mouse position
                const dx = mouseX - centerX;
                const dy = mouseY - centerY;
                const distToMouse = Math.sqrt(dx * dx + dy * dy);
                
                let rx = s.radius;
                let ry = s.radius * 0.55; // Elliptical perspective skew
                
                // Push radius outward slightly if warping
                if (warpActive) {
                    s.radius += (s.originalRadius * 2.8 - s.radius) * 0.02;
                } else {
                    s.radius += (s.originalRadius - s.radius) * 0.02;
                }

                // Star position relative to gravity center
                let sx = centerX + Math.cos(s.angle) * rx;
                let sy = centerY + Math.sin(s.angle) * ry;

                // Subtle magnetic distortion toward mouse cursor
                if (distToMouse < 400) {
                    const pullStrength = (1.0 - distToMouse / 400) * 0.15;
                    sx += (mouseX - sx) * pullStrength;
                    sy += (mouseY - sy) * pullStrength;
                }

                vCtx.beginPath();
                // Render streaks when warping, otherwise circular stars
                if (warpFactor > 1.5) {
                    const prevX = centerX + Math.cos(s.angle - s.speed * warpFactor * 1.5) * rx;
                    const prevY = centerY + Math.sin(s.angle - s.speed * warpFactor * 1.5) * ry;
                    vCtx.moveTo(prevX, prevY);
                    vCtx.lineTo(sx, sy);
                    vCtx.strokeStyle = `rgba(230, 200, 156, ${s.brightness * 0.8})`;
                    vCtx.lineWidth = s.size;
                    vCtx.stroke();
                } else {
                    vCtx.arc(sx, sy, s.size * (warpFactor > 1.2 ? 1.5 : 1), 0, Math.PI * 2);
                    vCtx.fillStyle = s.colorChance > 0.85 
                        ? `rgba(230, 200, 156, ${s.brightness})` 
                        : `rgba(200, 169, 126, ${s.brightness * 0.6})`;
                    vCtx.shadowBlur = s.size > 0.8 ? 5 : 0;
                    vCtx.shadowColor = 'rgba(200, 169, 126, 0.3)';
                    vCtx.fill();
                }
            });

            requestAnimationFrame(drawVortex);
        }

        // Esoteric Astrological Glyph Decryptor text reveal effect on load (Impeccable flourish)
        const glyphs = ['✦', '✶', '☿', '♀', '♂', '♄', '☉', '☽', '♃', '⚛', '⚜', '✵', '❂', '💠'];
        
        function decryptText(element, originalHTML) {
            const tempText = element.textContent.trim();
            const length = tempText.length;
            let currentIteration = 0;
            
            const decryptInterval = setInterval(() => {
                element.innerHTML = tempText
                    .split('')
                    .map((char, index) => {
                        if (char === ' ' || index < currentIteration) {
                            // Preserve HTML wrappers like <span> once decrypted
                            if (index < currentIteration) {
                                return originalHTML.split('')[index] || char;
                            }
                            return char;
                        }
                        return glyphs[Math.floor(Math.random() * glyphs.length)];
                    })
                    .join('');
                
                currentIteration += length / 40;
                if (currentIteration >= length) {
                    clearInterval(decryptInterval);
                    element.innerHTML = originalHTML; // Restore full original HTML structure
                }
            }, 30);
        }

