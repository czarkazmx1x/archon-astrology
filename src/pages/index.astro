                const textCenter = document.querySelector('.font-display-lg.text-display-lg.text-muted-gold');
                if (textCenter) {
                    textCenter.style.opacity = '0';
                    setTimeout(() => {
                        textCenter.innerText = "ALIGNING";
                        textCenter.className = "font-label-caps text-label-caps text-muted-gold animate-pulse tracking-widest scale-100 duration-500 transition-all";
                        textCenter.style.opacity = '1';
                    }, 500);

                    setTimeout(() => {
                        textCenter.innerText = sign;
                        textCenter.className = "font-headline-md text-headline-md text-muted-gold tracking-widest uppercase scale-110 duration-500 transition-all";
                        textCenter.style.opacity = '1';
                    }, 2500);
                }

                // Call FreeAstroAPI live planets calculator
                const mIndex = months.indexOf(m) + 1;
                const planetsContainer = document.getElementById("birth-planets-container");
                const planetsList = document.getElementById("planets-list");

                if (planetsContainer && planetsList) {
                    planetsList.innerHTML = `<div class="col-span-2 text-center text-on-surface-variant/40 animate-pulse uppercase tracking-widest text-[10px]">Mapping celestial coordinates...</div>`;
                    planetsContainer.classList.remove("hidden");
                    setTimeout(() => {
                        planetsContainer.style.opacity = "1";
                        planetsContainer.style.transform = "scale(1)";
                    }, 100);

                    const payload = {
                        year: y || 1990,
                        month: mIndex,
                        day: d,
                        hour: 12,
                        min: 0,
                        lat: 40.7128,
                        lon: -74.0060,
                        tzone: -5,
                        ayanamsa: 1
                    };

                    fetch("https://json.freeastrologyapi.com/planets", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "x-api-key": "4aa8230c71f86fdc80d2523daaad5d4884aeb280b5fc57dbc48faa542d86e06"
                        },
                        body: JSON.stringify(payload)
                    })
                    .then(res => {
                        if (!res.ok) throw new Error("API rate-limited or offline");
                        return res.json();
                    })
                    .then(data => {
                        planetsList.innerHTML = "";
                        const planetsArray = Array.isArray(data) ? data : (data.planets ? Object.values(data.planets) : []);
                        
                        if (planetsArray.length === 0) throw new Error("No data");

                        planetsArray.forEach(p => {
                            const icon = planetIcons[p.name];
                            if (icon) {
                                const card = document.createElement("div");
                                card.className = "flex items-center gap-3 bg-surface-container-low/50 p-3 rounded-lg border border-on-surface/5";
                                card.innerHTML = `
                                    <span class="text-xl">${icon}</span>
                                    <div>
                                        <p class="text-[9px] uppercase tracking-wider opacity-50">${p.name}</p>
                                        <p class="font-bold text-muted-gold">${p.sign}</p>
                                    </div>
                                `;
                                planetsList.appendChild(card);
                            }
                        });
                    })
                    .catch(err => {
                        planetsList.innerHTML = `
                            <div class="col-span-2 text-center bg-surface-container-low/40 p-4 border border-red-900/10 rounded">
                                <p class="text-[11px] text-muted-gold uppercase tracking-wider">Celestial Offline Mode Enabled</p>
                                <p class="text-[9px] text-on-surface-variant/60 mt-1">Sun calculated in ${sign}. Live alignments temporarily rate-limited.</p>
                            </div>
                        `;
                    });
                }
            });
        }

        // 5. Life Path Numerology Calculator
        function reduceNum(n) {
            let sum = 0;
            while (n > 0 || sum > 9) {
                if (n === 0) {
                    n = sum;
                    sum = 0;
                }
                sum += n % 10;
                n = Math.floor(n / 10);
            }
            return sum;
        }

        function getLifePathNumber(monthName, day, year) {
            const mIndex = months.indexOf(monthName) + 1;
            const monthVal = (mIndex === 11) ? 11 : reduceNum(mIndex);
            const dayVal = (day === 11 || day === 22) ? day : reduceNum(day);
            let yearVal = reduceNum(year);

            const total = monthVal + dayVal + yearVal;
            if (total === 11 || total === 22 || total === 33) return total;
            return reduceNum(total);
        }

        const archetypes = {
            1: "The Initiator",
            2: "The Peacekeeper",
            3: "The Creative",
            4: "The Builder",
            5: "The Explorer",
            6: "The Nurturer",
            7: "The Seeker",
            8: "The Executive",
            9: "The Philosopher",
            11: "The Intuitive Guide",
            22: "The Master Builder",
            33: "The Master Teacher"
        };

        if (lifepathBtn) {
            lifepathBtn.addEventListener('click', function(e) {
                e.preventDefault();
                const m = lifepathMonth.value;
                const d = parseInt(lifepathDay.value);
                const y = parseInt(lifepathYear.value);
                const pathNumber = getLifePathNumber(m, d, y);
                const archetype = archetypes[pathNumber] || "The Traveler";

                if (lifepathResultNum) {
                    lifepathResultNum.style.transition = 'transform 0.5s ease';
                    lifepathResultNum.style.transform = 'scale(0)';
                    setTimeout(() => {
                        lifepathResultNum.innerText = pathNumber;
                        lifepathResultNum.style.transform = 'scale(1.2)';
                    }, 500);
                }

                if (lifepathResultLabel) {
                    lifepathResultLabel.innerText = archetype;
                    lifepathResultLabel.className = "font-label-caps text-label-caps text-muted-gold mt-2 block animate-pulse";
                }
            });
        }
    });
</script>
</body></html>
