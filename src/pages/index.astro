            // Animate out
            requestAnimationFrame(() => {
                sparkle.style.opacity = '0';
                sparkle.style.transform = `translate(calc(-50% + ${tx}px), calc(-50% + ${ty}px)) scale(0.1)`;
            });

            setTimeout(() => {
