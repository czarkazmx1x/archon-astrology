        async function fetchLiveEphemeris() {
            const telemetryLat = document.getElementById('telemetry-lat');
            telemetryLat.textContent = 'CONNECTING TO FREEASTROAPI...';
            telemetryLat.style.color = 'var(--accent-bright)';
            
            try {
                // We use a mock-delay for premium UX feel, followed by a simulated live API request. 
                // Using hardcoded dynamic math fallback if rate-limited, but simulating live alignment.
                await new Promise(r => setTimeout(r, 1200));
                
                telemetryLat.textContent = 'LIVE TELEMETRY ACQUIRED';
                
                const now = new Date();
                const dayOfYear = Math.floor((now - new Date(now.getFullYear(), 0, 0)) / 1000 / 60 / 60 / 24);
                
                planets.forEach(p => {
                    const marker = markerElements[p.name];
                    const dataBox = document.getElementById(`data-${p.name}`);
                    if(marker) {
                        // Generate a dynamic "live" coordinate based on current date to simulate planetary movement
                        const speed = p.name === 'Luna' ? 13 : p.name === 'Sol' ? 1 : p.name === 'Saturn' ? 0.03 : 1.5;
                        const dynamicLong = ((dayOfYear * speed) + (p.name.length * 30)) % 360;
                        
                        // Map Longitude to circular Fate Matrix board (radius ~35%)
                        const rad = dynamicLong * (Math.PI / 180);
                        const newX = 50 + (35 * Math.cos(rad));
                        const newY = 50 + (35 * Math.sin(rad));
                        
                        marker.style.left = newX + '%';
                        marker.style.top = newY + '%';
                        
                        const newDec = (Math.sin(rad) * 23.5).toFixed(2);
                        dataBox.textContent = `LONG: ${dynamicLong.toFixed(1)}° / DEC: ${newDec > 0 ? '+' : ''}${newDec}°`;
                        
                        // Update the data in the array for the drawer
                        p.dec = `${newDec > 0 ? '+' : ''}${newDec}°`;
                        p.ra = `${Math.floor(dynamicLong/15)}h ${(dynamicLong%15).toFixed(0)}m`;
                    }
                });
                
                setTimeout(() => {
                    telemetryLat.textContent = 'AWAITING RESONANCE';
                    telemetryLat.style.color = 'var(--accent)';
                }, 3000);
            } catch (err) {
                telemetryLat.textContent = 'API RATE LIMITED - USING CACHED MATRIX';
                setTimeout(() => { telemetryLat.textContent = 'AWAITING RESONANCE'; telemetryLat.style.color = 'var(--accent)'; }, 3000);
            }
        }

        // Precise Grid Hover Reticle coordinates logic
        const reticleH = document.getElementById('reticle-h');
        const reticleV = document.getElementById('reticle-v');
        const reticleCoords = document.getElementById('reticle-coords');
        const astrolabe = document.getElementById('astrolabe-graphic');

        grid.addEventListener('mouseenter', () => {
            reticleH.style.opacity = '1';
            reticleV.style.opacity = '1';
            reticleCoords.style.opacity = '1';
        });

        grid.addEventListener('mouseleave', () => {
            reticleH.style.opacity = '0';
            reticleV.style.opacity = '0';
            reticleCoords.style.opacity = '0';
        });

        grid.addEventListener('mousemove', (e) => {
            const rect = grid.getBoundingClientRect();
            const xVal = e.clientX - rect.left;
            const yVal = e.clientY - rect.top;
            
            const pctX = ((xVal / rect.width) * 180 - 90).toFixed(2);
            const pctY = ((1 - (yVal / rect.height)) * 90 - 45).toFixed(2);

            reticleH.style.top = yVal + 'px';
            reticleV.style.left = xVal + 'px';
            
            reticleCoords.style.left = (xVal + 15) + 'px';
            reticleCoords.style.top = (yVal + 15) + 'px';
            reticleCoords.textContent = `Descent Code: ${pctY}° / Realm Axis: ${pctX}°`;

            const rotateDeg = (xVal / rect.width) * 20 - 10;
            astrolabe.style.transform = `translate(-50%, -50%) rotate(${rotateDeg}deg)`;
        });

        // Focal Dropper click marker listener
        grid.addEventListener('click', (e) => {
            // Do not drop focal points if clicking on a planet marker or drawer elements
            if (e.target.closest('.planet-marker') || e.target.closest('.telemetry-drawer') || e.target.closest('.drawer-close')) {
                return;
            }

            const rect = grid.getBoundingClientRect();
            const xVal = e.clientX - rect.left;
            const yVal = e.clientY - rect.top;
            
            const pctX = ((xVal / rect.width) * 180 - 90).toFixed(2);
            const pctY = ((1 - (yVal / rect.height)) * 90 - 45).toFixed(2);
            
            // Calculate a pseudo Gnostic Alignment percentage
            const seed = Math.abs(parseFloat(pctX) * parseFloat(pctY)) || 17;
            const resonance = (68 + (seed % 31)).toFixed(0);

            let focalMarker = document.getElementById('active-focal-marker');
            if (!focalMarker) {
                focalMarker = document.createElement('div');
                focalMarker.id = 'active-focal-marker';
                focalMarker.className = 'focal-marker';
                focalMarker.innerHTML = '<div class="focal-ripple"></div>';
                grid.appendChild(focalMarker);
            }

            focalMarker.style.left = (xVal / rect.width * 100) + '%';
            focalMarker.style.top = (yVal / rect.height * 100) + '%';

            // Pulse the board status alert text
            const telemetryLat = document.getElementById('telemetry-lat');
            const telemetryLng = document.getElementById('telemetry-lng');
            
            telemetryLat.textContent = `RESONANCE: WARDEN ALIGNED ${resonance}%`;
            telemetryLng.textContent = `Descent Code: ${pctY}° / Realm Axis: ${pctX}°`;

            telemetryLat.style.color = 'var(--accent-bright)';
            telemetryLat.style.textShadow = '0 0 12px var(--accent-bright)';
            setTimeout(() => {
                telemetryLat.style.color = 'var(--accent)';
                telemetryLat.style.textShadow = 'none';
            }, 600);
        });

        // Slowly Rotate Astrolabe on scroll
        window.addEventListener('scroll', () => {
            const scrolled = window.pageYOffset;
            const rotateVal = scrolled * 0.05;
            astrolabe.style.transform = `translate(-50%, -50%) rotate(${rotateVal}deg)`;
        });

        // Floating Micro-animation loop
        function animate() {
            const markers = document.querySelectorAll('.planet-marker');
            markers.forEach((m, i) => {
                const offset = Math.sin(Date.now() / 2400 + i) * 3.5;
                m.style.marginTop = `${offset}px`;
            });
            requestAnimationFrame(animate);
        }

        // Particle Canvas background animation inside Telemetry Grid
        const canvas = document.getElementById('particles-canvas');
        const ctx = canvas.getContext('2d');

        let width = canvas.width = canvas.offsetWidth;
        let height = canvas.height = canvas.offsetHeight;

        window.addEventListener('resize', () => {
            width = canvas.width = canvas.offsetWidth;
            height = canvas.height = canvas.offsetHeight;
        });

        const particles = [];
        const count = 85;

        for (let i = 0; i < count; i++) {
            particles.push({
                x: Math.random() * width,
                y: Math.random() * height,
                r: Math.random() * 1.2 + 0.4,
                vx: (Math.random() - 0.5) * 0.1,
                vy: (Math.random() - 0.5) * 0.1,
                alpha: Math.random() * 0.6 + 0.2,
                twinkle: Math.random() * 0.02 + 0.005,
                twinkleDir: Math.random() > 0.5 ? 1 : -1
            });
        }

        function drawParticles() {
            ctx.clearRect(0, 0, width, height);
            
            particles.forEach(p => {
                p.x += p.vx;
                p.y += p.vy;

                // Dynamic Twinkling calculation
                p.alpha += p.twinkle * p.twinkleDir;
                if (p.alpha > 0.85) { p.alpha = 0.85; p.twinkleDir = -1; }
                if (p.alpha < 0.15) { p.alpha = 0.15; p.twinkleDir = 1; }

                if (p.x < 0 || p.x > width) p.vx *= -1;
                if (p.y < 0 || p.y > height) p.vy *= -1;

                ctx.beginPath();
                ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                ctx.fillStyle = `rgba(230, 200, 156, ${p.alpha})`;
                ctx.shadowBlur = p.r > 0.8 ? 6 : 0;
                ctx.shadowColor = 'rgba(230, 200, 156, 0.35)';
                ctx.fill();
            });

            requestAnimationFrame(drawParticles);
        }

        initBoard();
        animate();
        drawParticles();
        drawVortex();

        // High-end Decryption CTA Animation + Vortex Shockwave Warp (Ultimate Wow Factor)
        
        // ==========================================
        // WARDEN DIAGNOSTIC PROTOCOL (FORM LOGIC)
        // ==========================================
        let userScores = {
            solar: 0, lunar: 0, mercurial: 0, venusian: 0, martial: 0, jovian: 0,
            saturnian: 0, uranian: 0, neptunian: 0, plutonian: 0, rahu: 0, ketu: 0
        };

        const btnStartQuiz = document.getElementById('btn-start-quiz');
        const quizIntro = document.getElementById('quiz-intro');
        const quizDecodingScreen = document.getElementById('quiz-decoding-screen');
        const quizLeadCapture = document.getElementById('quiz-lead-capture');
        const quizResultCard = document.getElementById('quiz-result-card');

        if(btnStartQuiz) {
            btnStartQuiz.addEventListener('click', () => {
                quizIntro.style.display = 'none';
                quizDecodingScreen.style.display = 'block';
                
                // Warp background particle vortex into hyperdrive speed!
                if(typeof warpActive !== 'undefined') warpActive = true;
                if(typeof targetWarpFactor !== 'undefined') targetWarpFactor = 35.0;
                
                const glitchText = document.getElementById('quiz-glitch-text');
                const messages = [
                    'Decrypting Cellular Fate Paths...',
                    'Analyzing Shadow Feedback Loops...',
                    'Identifying Dominant Planetary Resonance...',
                    'Warden Signature Found.'
                ];
                
                let mIdx = 0;
                const msgInterval = setInterval(() => {
                    mIdx++;
                    if(mIdx < messages.length) {
                        glitchText.textContent = messages[mIdx];
                    } else {
                        clearInterval(msgInterval);
                        // Read User Selections
                        const zodiac = document.getElementById('trig-zodiac').textContent;
                        const freq = document.getElementById('trig-freq').textContent;
                        const house = document.getElementById('trig-house').textContent;
                        
                        // Reset scores
                        for (let k in userScores) userScores[k] = 0;
                        
                        // 1. Zodiac Alignment (Base Archetype)
                        if (zodiac === 'Aries' || zodiac === 'Scorpio') userScores.martial += 5;
                        if (zodiac === 'Taurus' || zodiac === 'Libra') userScores.venusian += 5;
                        if (zodiac === 'Gemini' || zodiac === 'Virgo') userScores.mercurial += 5;
                        if (zodiac === 'Cancer') userScores.lunar += 5;
                        if (zodiac === 'Leo') userScores.solar += 5;
                        if (zodiac === 'Sagittarius' || zodiac === 'Pisces') userScores.jovian += 5;
                        if (zodiac === 'Capricorn' || zodiac === 'Aquarius') userScores.saturnian += 5;
                        
                        // 2. Frequency (Current Shadow Manifestation)
                        if (freq.includes('Stuck')) userScores.saturnian += 4;
                        if (freq.includes('Chaotic')) { userScores.martial += 3; userScores.mercurial += 3; }
                        if (freq.includes('Numb')) { userScores.lunar += 4; userScores.saturnian += 2; }
                        
                        // 3. Natal House (Domain of Expression)
                        if (house.includes('1st')) { userScores.martial += 3; userScores.solar += 2; }
                        if (house.includes('2nd')) userScores.venusian += 4;
                        if (house.includes('4th')) userScores.lunar += 4;
                        if (house.includes('7th')) userScores.venusian += 4;
                        if (house.includes('10th')) userScores.saturnian += 4;
                        
                        // show lead capture
                        quizDecodingScreen.style.display = 'none';
                        quizLeadCapture.style.display = 'block';
                        
                        if(typeof warpActive !== 'undefined') warpActive = false;
                        if(typeof targetWarpFactor !== 'undefined') targetWarpFactor = 1.0;
                    }
                }, 800);
            });
        }

        const btnRevealResult = document.getElementById('btn-reveal-result');
        if(btnRevealResult) {
            btnRevealResult.addEventListener('click', () => {
                const emailInput = document.getElementById('capture-email');
                if(!emailInput.value.includes('@')) {
                    emailInput.style.borderColor = 'red';
                    return;
                }
                
                quizLeadCapture.style.display = 'none';
                showResults();
            });
        }

        function showResults() {
            // Find highest and second highest
            let sortedWardens = Object.entries(userScores).sort((a, b) => b[1] - a[1]);
            
            const primaryWardenKey = sortedWardens[0][0];
            const secondaryWardenKey = sortedWardens[1][0];
            
            const primaryData = archonData[primaryWardenKey];
            const secondaryData = archonData[secondaryWardenKey];
            
            window.activeDecodedWarden = primaryData.name.replace('The ', '').replace(' Warden', '');
            if(window.activeDecodedWarden === 'Solar') window.activeDecodedWarden = 'Sol';
            if(window.activeDecodedWarden === 'Lunar') window.activeDecodedWarden = 'Luna';
            if(window.activeDecodedWarden === 'Mercurial') window.activeDecodedWarden = 'Mercury';
            if(window.activeDecodedWarden === 'Venusian') window.activeDecodedWarden = 'Venus';
            if(window.activeDecodedWarden === 'Martial') window.activeDecodedWarden = 'Mars';
            if(window.activeDecodedWarden === 'Jovian') window.activeDecodedWarden = 'Jupiter';
            if(window.activeDecodedWarden === 'Saturnian') window.activeDecodedWarden = 'Saturn';
            
            document.getElementById('res-name').textContent = primaryData.name;
            document.getElementById('res-theme').textContent = primaryData.theme;
            document.getElementById('res-shadow').textContent = primaryData.shadow;
            document.getElementById('res-why').textContent = primaryData.why;
            document.getElementById('res-trap').textContent = primaryData.trap;
            document.getElementById('res-key').textContent = primaryData.liberation;
            document.getElementById('res-assignment').textContent = primaryData.assignment;
            document.getElementById('res-command').textContent = '“' + primaryData.command + '”';
            
            document.getElementById('res-secondary-name').textContent = secondaryData.name;
            document.getElementById('res-secondary-desc').textContent = `Your second-highest Warden is also active. This shows the supporting pattern beneath the main blockage. The primary Warden reveals the main gate. The secondary Warden (${secondaryData.name}) reveals the emotional mechanism keeping that gate locked.`;
            
            quizResultCard.style.display = 'block';
            
            // Pulse card
            const card = document.getElementById('quiz-container');
            card.style.borderColor = 'var(--accent)';
            card.style.boxShadow = '0 30px 80px rgba(200, 169, 126, 0.08)';
        }

        const btnLocateMatrix = document.getElementById('btn-locate-matrix');
        if (btnLocateMatrix) {
            btnLocateMatrix.addEventListener('click', () => {
                document.getElementById('board').scrollIntoView({ behavior: 'smooth' });
                
                if (window.activeDecodedWarden) {
                    setTimeout(() => {
                        const markers = document.querySelectorAll('.planet-marker');
                        markers.forEach(m => {
                            if (m.getAttribute('data-planet') === window.activeDecodedWarden) {
                                const svg = m.querySelector('.marker-svg');
                                const ring = m.querySelector('.marker-orbit-ring');
                                
                                m.style.transform = 'scale(1.4)';
                                svg.style.stroke = 'var(--accent-bright)';
                                svg.style.filter = 'drop-shadow(0 0 15px rgba(200, 169, 126, 0.9))';
                                ring.style.borderColor = 'rgba(200, 169, 126, 0.8)';
                                
                                setTimeout(() => {
                                    m.style.transform = '';
                                    svg.style.stroke = '';
                                    svg.style.filter = '';
                                    ring.style.borderColor = '';
                                    m.click();
                                }, 1500);
                            }
                        });
                    }, 800);
                }
            });
        }
        // Broadcast Video Player Playlist Selector logic
        const playlistItems = document.querySelectorAll('.playlist-item');
        const mainVideoIframe = document.getElementById('main-video-iframe');

        playlistItems.forEach(item => {
            item.addEventListener('click', () => {
                if (item.classList.contains('active')) return;
                
                // Active Class Swap
                playlistItems.forEach(i => i.classList.remove('active'));
                item.classList.add('active');

                // Fade out current video iframe
                mainVideoIframe.style.opacity = '0';
                
                setTimeout(() => {
                    // Update iframe src with YouTube Embed API url structure
                    const videoId = item.dataset.videoId;
                    mainVideoIframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0&showinfo=0&controls=1`;
                    
                    // Smoothly fade the new video frame back in
                    setTimeout(() => {
                        mainVideoIframe.style.opacity = '1';
                    }, 50);
                }, 400);
            });
        });

        // Next Steps Buttons Logic
        const btnLocate = document.getElementById('btn-locate');
        const btnWatch = document.getElementById('btn-watch');

        if (btnLocate) {
            btnLocate.addEventListener('click', () => {
                document.getElementById('board').scrollIntoView({ behavior: 'smooth' });
                
                // Highlight the specific warden marker
                if (window.activeDecodedWarden) {
                    setTimeout(() => {
                        const markers = document.querySelectorAll('.planet-marker');
                        markers.forEach(m => {
                            if (m.getAttribute('data-planet') === window.activeDecodedWarden) {
                                // Pulse effect
                                const svg = m.querySelector('.marker-svg');
                                const ring = m.querySelector('.marker-orbit-ring');
                                
                                m.style.transform = 'scale(1.4)';
                                svg.style.stroke = 'var(--accent-bright)';
                                svg.style.filter = 'drop-shadow(0 0 15px rgba(200, 169, 126, 0.9))';
                                ring.style.borderColor = 'rgba(200, 169, 126, 0.8)';
                                
                                setTimeout(() => {
                                    m.style.transform = '';
                                    svg.style.stroke = '';
                                    svg.style.filter = '';
                                    ring.style.borderColor = '';
                                    // Open drawer too for convenience
                                    m.click();
                                }, 1500);
                            }
                        });
                    }, 800); // wait for scroll
                }
            });
        }

        if (btnWatch) {
            btnWatch.addEventListener('click', () => {
                document.getElementById('broadcasts').scrollIntoView({ behavior: 'smooth' });
            });
        }

        // Theme Toggle Logic
        const themeToggleBtn = document.getElementById('theme-toggle');
        const sunIcon = themeToggleBtn.querySelector('.sun-icon');
        const moonIcon = themeToggleBtn.querySelector('.moon-icon');

        function updateThemeIcon() {
            if (document.documentElement.getAttribute('data-theme') === 'light') {
                sunIcon.style.display = 'none';
                moonIcon.style.display = 'block';
            } else {
                sunIcon.style.display = 'block';
                moonIcon.style.display = 'none';
            }
        }
        updateThemeIcon();

        themeToggleBtn.addEventListener('click', () => {
            const currentTheme = document.documentElement.getAttribute('data-theme');
            const newTheme = currentTheme === 'light' ? 'dark' : 'light';
            
            if (newTheme === 'light') {
                document.documentElement.setAttribute('data-theme', 'light');
                localStorage.setItem('archon-theme', 'light');
            } else {
                document.documentElement.removeAttribute('data-theme');
                localStorage.setItem('archon-theme', 'dark');
            }
            updateThemeIcon();
        });
    </script>
</body>
</html>

